services:
  dockhand:
    image: "fnsys/dockhand:{{ dockhand_version | default('latest') }}"
    container_name: dockhand
    restart: unless-stopped
    ports:
      - "{{ dockhand_port | default(3001) }}:3000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - dockhand_data:/app/data

volumes:
  dockhand_data:
