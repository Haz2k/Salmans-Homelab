# infra control-plane apps, higher-value targets if exposed publicly.
- Infrastructure (LAN only):
    - Semaphore:
        href: http://{{ lxc_services.ansible_control.ip }}:3000
        icon: semaphore.png
    - Pi-hole:
        href: http://{{ lxc_services.pihole.ip }}:8081/admin
        icon: pi-hole.png
    - Proxmox (pve1):
        href: https://192.168.0.100:8006
        icon: proxmox.png
    - Proxmox (pve2):
        href: https://192.168.0.150:8006
        icon: proxmox.png
