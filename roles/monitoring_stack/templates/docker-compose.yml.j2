# Sources (official docs, per app):
#   Prometheus:   https://prometheus.io/docs/prometheus/latest/installation/
#   Grafana:      https://grafana.com/docs/grafana/latest/setup-grafana/installation/docker/
#   node_exporter: https://github.com/prometheus/node_exporter#docker
#   pve_exporter:  https://github.com/prometheus-pve/prometheus-pve-exporter#docker
#   cadvisor:     https://github.com/google/cadvisor/blob/master/docs/running.md#docker
#   Scrutiny:     https://github.com/AnalogJ/scrutiny#docker-compose-recommended
#   Uptime Kuma:  https://github.com/louislam/uptime-kuma/wiki/%F0%9F%94%A7-How-to-Install
#   Speedtest Tracker: https://docs.speedtest-tracker.dev/getting-started/installation
#   Homepage:     https://gethomepage.dev/installation/docker/
services:
  prometheus:
    image: prom/prometheus@sha256:5ce7540c3c00ef4ab0c9d2c995c6a5b9c421f44b4a115d97a2c7af3b1c21cbb0
    container_name: prometheus
    volumes:
      - /opt/monitoring_stack/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
      - /opt/monitoring_stack/prometheus/data:/prometheus
    ports:
      - "9090:9090"
    restart: unless-stopped
  grafana:
    image: grafana/grafana@sha256:3fd54ae1214669f8355f065ec9f6445d5279a3d77095ab048ca045685272429b
    container_name: grafana
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "{{ vault_grafana_admin_password }}"
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: "Admin"
    volumes:
      - /opt/monitoring_stack/grafana:/var/lib/grafana
      - /opt/monitoring_stack/grafana-provisioning:/etc/grafana/provisioning
      - /opt/monitoring_stack/grafana-dashboards:/var/lib/grafana/dashboards
    ports:
      - "3000:3000"
    restart: unless-stopped
  node_exporter:
    image: prom/node-exporter@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0
    container_name: node_exporter
    pid: host
    volumes:
      - /:/host:ro,rslave
    command:
      - '--path.rootfs=/host'
    ports:
      - "9100:9100"
    restart: unless-stopped
  pve_exporter:
    image: prompve/prometheus-pve-exporter:3.10.0@sha256:4867684c0a937716f11f770a32d32958bded507cf570fc334f774392afcb2f37
    container_name: pve_exporter
    volumes:
      - /opt/monitoring_stack/pve_exporter/pve.yml:/etc/prometheus/pve.yml
    ports:
      - "9221:9221"
    restart: unless-stopped
  cadvisor:
    image: gcr.io/cadvisor/cadvisor@sha256:3de2bd5203120b866d74a9b283b2ffb8ec382fbf9dc321814700c6ea6f44ec57
    container_name: cadvisor
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    ports:
      - "8085:8080"
    restart: unless-stopped
  scrutiny:
    image: ghcr.io/analogj/scrutiny@sha256:2f3d23edadf6d12f9c26d16808bd8620852a37dd3074e814352a2328d48fccb0
    container_name: scrutiny
    cap_add:
      - SYS_RAWIO
      - SYS_ADMIN
    volumes:
      - /run/udev:/run/udev:ro
      - /opt/monitoring_stack/scrutiny/config:/opt/scrutiny/config
      - /opt/monitoring_stack/scrutiny/influxdb:/opt/scrutiny/influxdb
    ports:
      - "8082:8080"
    restart: unless-stopped
  uptime_kuma:
    image: louislam/uptime-kuma@sha256:3d632903e6af34139a37f18055c4f1bfd9b7205ae1138f1e5e8940ddc1d176f9
    container_name: uptime_kuma
    volumes:
      - /opt/monitoring_stack/uptime_kuma:/app/data
    ports:
      - "3001:3001"
    restart: unless-stopped
  speedtest_tracker:
    image: lscr.io/linuxserver/speedtest-tracker@sha256:59518a6f2b49254b310cc2e543320dd3fbaa80381b588cd1f2bf116073698c27
    container_name: speedtest_tracker
    environment:
      PUID: 1000
      PGID: 1000
      TZ: "{{ vault_timezone }}"
      APP_KEY: "{{ vault_speedtest_tracker_app_key }}"
    volumes:
      - /opt/monitoring_stack/speedtest_tracker:/config
    ports:
      - "8765:80"
    restart: unless-stopped
  homepage:
    image: ghcr.io/gethomepage/homepage:v2.1.2@sha256:da9dca9ec258c628146bed1445da0853f2b88f0b10bafd97c091de807c363d60
    container_name: homepage
    environment:
      TZ: "{{ vault_timezone }}"
      HOMEPAGE_ALLOWED_HOSTS: "homepage.{{ vault_domain }}"
    volumes:
      - /opt/monitoring_stack/homepage:/app/config
    ports:
      - "3003:3000"
    restart: unless-stopped
