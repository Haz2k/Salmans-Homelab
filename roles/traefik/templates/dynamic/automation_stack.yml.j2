# Static routes for automation_stack — separate LXC from Traefik.
# All routes gated behind Authelia SSO.
http:
  routers:
    homeassistant:
      rule: "Host(`ha.{{ vault_domain }}`)"
      entrypoints:
        - websecure
      service: homeassistant
      middlewares:
        - authelia@docker
      tls:
        certResolver: letsencrypt
    paperless:
      rule: "Host(`paperless.{{ vault_domain }}`)"
      entrypoints:
        - websecure
      service: paperless
      middlewares:
        - authelia@docker
      tls:
        certResolver: letsencrypt

  services:
    homeassistant:
      loadBalancer:
        servers:
          - url: "http://{{ lxc_services.automation_stack.ip }}:8123"
    paperless:
      loadBalancer:
        servers:
          - url: "http://{{ lxc_services.automation_stack.ip }}:8000"
