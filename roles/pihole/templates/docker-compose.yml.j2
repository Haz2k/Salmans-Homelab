# Source: Pi-hole official docs — https://docs.pi-hole.net/docker/
services:
  pihole:
    container_name: pihole
    image: pihole/pihole:2025.07.0
    hostname: pihole
    restart: unless-stopped
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "67:67/udp"   # DHCP, only if Pi-hole handles DHCP
      - "8081:80/tcp" # web UI, mapped off 80 since Traefik owns 80/443 elsewhere
    environment:
      TZ: "{{ vault_timezone }}"
      FTLCONF_webserver_api_password: "{{ vault_pihole_webpassword }}"
      FTLCONF_dns_listeningMode: "all"
    volumes:
      - /opt/pihole/etc-pihole:/etc/pihole
      - /opt/pihole/etc-dnsmasq.d:/etc/dnsmasq.d
    cap_add:
      - NET_ADMIN
