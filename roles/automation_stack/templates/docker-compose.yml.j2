# Sources (official docs, per app):
#   Home Assistant: https://www.home-assistant.io/installation/linux#install-home-assistant-container
#   Ollama:          https://github.com/ollama/ollama/blob/main/docs/docker.md
#   Paperless-ngx:   https://github.com/paperless-ngx/paperless-ngx/blob/main/docker/compose/docker-compose.postgres-tika.yml

services:
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:2026.8.2@sha256:56690a89c79a0de98035e1719f8324a92d5859c1192ff45adb0230ea81cb42a5
    container_name: homeassistant
    volumes:
      - /opt/automation_stack/homeassistant:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    network_mode: host   # required for device discovery (HA official recommendation)

  ollama:
    image: ollama/ollama@sha256:9d30908e41144b1f1da89b9d8e33c07e4aeb43ff41a8660241b1686e2cc330ad
    container_name: ollama
    volumes:
      - /opt/automation_stack/ollama:/root/.ollama
    ports:
      - "11434:11434"
    restart: unless-stopped

  paperless-broker:
    image: docker.io/library/redis:7@sha256:e9b2e45ecd47fbb69b877cf8d045d5cccaaaed52524b6e098b4abe8212994f73
    container_name: paperless-broker
    restart: unless-stopped
    volumes:
      - /opt/automation_stack/paperless/redisdata:/data

  paperless-db:
    image: docker.io/library/postgres:16@sha256:e17e86066e5ef83e0952a9347f5c792b7ece00972e2aa787a6986f471b3dd3d5
    container_name: paperless-db
    restart: unless-stopped
    volumes:
      - /opt/automation_stack/paperless/pgdata:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: paperless
      POSTGRES_USER: paperless
      POSTGRES_PASSWORD: "{{ vault_paperless_db_password }}"

  paperless-gotenberg:
    image: docker.io/gotenberg/gotenberg:8.36.0@sha256:87c16b9f364279d321bc9772d31fa58aa6abe036423c270698bd636c3a8e9466
    container_name: paperless-gotenberg
    restart: unless-stopped
    command:
      - "gotenberg"
      - "--chromium-disable-javascript=true"
      - "--chromium-allow-list=file:///tmp/.*"

  paperless-tika:
    image: docker.io/apache/tika@sha256:90b7fa1dc018434075fce9e1d9b88b1e3d0ea6979d0cf86e116c79a8073ae973
    container_name: paperless-tika
    restart: unless-stopped

  paperless:
    image: ghcr.io/paperless-ngx/paperless-ngx:3.0.5@sha256:65a4cabf0169ea7fbd90ab7bb28ba3f8b5909613635acda1a03ad606f34b456b
    container_name: paperless
    restart: unless-stopped
    depends_on:
      - paperless-db
      - paperless-broker
      - paperless-gotenberg
      - paperless-tika
    ports:
      - "8000:8000"
    volumes:
      - /opt/automation_stack/paperless/data:/usr/src/paperless/data
      - /opt/automation_stack/paperless/media:/usr/src/paperless/media
      - /opt/automation_stack/paperless/export:/usr/src/paperless/export
      - /opt/automation_stack/paperless/consume:/usr/src/paperless/consume
    environment:
      PAPERLESS_REDIS: redis://paperless-broker:6379
      PAPERLESS_DBHOST: paperless-db
      PAPERLESS_DBPASS: "{{ vault_paperless_db_password }}"
      PAPERLESS_DBENGINE: postgresql
      PAPERLESS_TIKA_ENABLED: 1
      PAPERLESS_TIKA_GOTENBERG_ENDPOINT: http://paperless-gotenberg:3000
      PAPERLESS_TIKA_ENDPOINT: http://paperless-tika:9998
      PAPERLESS_SECRET_KEY: "{{ vault_paperless_secret_key }}"
      PAPERLESS_TIME_ZONE: "{{ vault_timezone }}"
      PAPERLESS_URL: "https://paperless.{{ vault_domain }}"
